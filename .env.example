# Discord bot token (required)
DISCORD_TOKEN=your-bot-token-here

# Application ID from the Discord Developer Portal (required for npm run deploy)
CLIENT_ID=your-application-id-here

# Optional: register commands in one guild instantly while developing.
# Leave empty to register global commands (can take up to an hour to appear).
GUILD_ID=

# Optional: comma-separated user IDs and role IDs allowed to manage settings
# in addition to members with the Manage Server permission.
AUTHORIZED_USER_IDS=
AUTHORIZED_ROLE_IDS=

# Optional: SQLite database location (default: data/autodelete.sqlite)
DB_PATH=data/autodelete.sqlite
